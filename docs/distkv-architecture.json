  "cards": [
    {
      "dot": "cyan",
      "title": "Consistency",
      "items": [
        "Tunable N/R/W quorum with N=3, R=2, W=2 defaults",
        "Vector clocks preserve concurrent siblings instead of discarding conflicts",
        "Quorum reads asynchronously repair causally stale replicas"
      ]
    },
    {
      "dot": "emerald",
      "title": "Convergence",
      "items": [
        "Gossip updates membership, liveness, addresses, and hash-ring ownership",
        "Anti-entropy exchanges a full local-data hash and applies missing or newer entries",
        "Scale-out data rebalancing and hinted handoff remain placeholders"
      ]
    },
    {
      "dot": "amber",
      "title": "Deployment",
      "items": [
        "Docker Compose and Kubernetes run three stateful nodes with persistent volumes",
        "A client may contact any node; that node becomes the request coordinator",
        "Monitoring configs exist, but DistKV does not currently expose /metrics"
      ]
    }
  ]
